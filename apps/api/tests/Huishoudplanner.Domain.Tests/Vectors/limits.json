    {
      "name": "one point per minute",
      "function": "defaultPointsForDuration",
      "input": {
        "minutes": 45
      },
      "expected": 45
    },
    {
      "name": "smallest duration",
      "function": "defaultPointsForDuration",
      "input": {
        "minutes": 1
      },
      "expected": 1
    },
    {
      "name": "floor of one point",
      "function": "defaultPointsForDuration",
      "input": {
        "minutes": 0
      },
      "expected": 1
    },
    {
      "name": "negative duration floors at one",
      "function": "defaultPointsForDuration",
      "input": {
        "minutes": -5
      },
      "expected": 1
    },
    {
      "name": "exactly the maximum",
      "function": "defaultPointsForDuration",
      "input": {
        "minutes": 1000
      },
      "expected": 1000
    },
    {
      "name": "capped at the maximum",
      "function": "defaultPointsForDuration",
      "input": {
        "minutes": 5000
      },
      "expected": 1000
    },
    {
      "name": "a half rounds up, like Math.round (0.5 gives 1)",
      "function": "defaultPointsForDuration",
      "input": {
        "minutes": 0.5
      },
      "expected": 1
    },
    {
      "name": "a half rounds up, not to even (2.5 gives 3)",
      "function": "defaultPointsForDuration",
      "input": {
        "minutes": 2.5
      },
      "expected": 3
    },
    {
      "name": "a half rounds up (1.5 gives 2)",
      "function": "defaultPointsForDuration",
      "input": {
        "minutes": 1.5
      },
      "expected": 2
    },
    {
      "name": "just below a half rounds down",
      "function": "defaultPointsForDuration",
      "input": {
        "minutes": 2.4
      },
      "expected": 2
    },
    {
      "name": "a half rounds up at 44.5",
      "function": "defaultPointsForDuration",
      "input": {
        "minutes": 44.5
      },
      "expected": 45
    },
    {
      "name": "a negative half is floored at one (-0.5)",
      "function": "defaultPointsForDuration",
      "input": {
        "minutes": -0.5
      },
      "expected": 1
    },
    {
      "name": "a negative half is floored at one (-2.5)",
      "function": "defaultPointsForDuration",
      "input": {
        "minutes": -2.5
      },
      "expected": 1
    },
    {
      "name": "a half just below the maximum rounds up to it",
      "function": "defaultPointsForDuration",
      "input": {
        "minutes": 999.5
      },
      "expected": 1000
    },
    {
      "name": "a fraction above the maximum is capped",
      "function": "defaultPointsForDuration",
      "input": {
        "minutes": 1000.4
      },
      "expected": 1000
    }
