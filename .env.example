PORT=3000
# docker compose only: host port, image tag and host folder for backups
APP_PORT=3000
APP_IMAGE_TAG=latest
BACKUP_HOST_DIR=./backups
MONGO_URL=mongodb://mongo:27017/huishoudplanner
TZ_APP=Europe/Amsterdam
# JSON, e.g. [{"name":"Anna","color":"#2563eb"},{"name":"Bram","color":"#db2777"}]
SEED_USERS=
LOG_LEVEL=info
BACKUP_RETENTION_DAYS=14
# empty = keep audit entries forever
AUDIT_RETENTION_DAYS=
# only the secret; provider type/endpoint/model live in settings
AI_API_KEY=
# none | ntfy | homeassistant
NOTIFY_TYPE=none
NOTIFY_URL=
NOTIFY_TOKEN=
# true in tests
DISABLE_SCHEDULER=false
